APP_NAME=SecureVault
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
# Identifiants fictifs, réservés au développement local.
# Ces URLs ciblent les ports publiés sur l'hôte. Compose utilise ses noms de service.
DATABASE_URL=postgresql+asyncpg://securevault:local_dev_only@127.0.0.1:5432/securevault
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=
SECRETS_ENCRYPTION_KEYS=
SECRETS_ACTIVE_KEY_VERSION=1
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=30
JWT_ISSUER=securevault
JWT_AUDIENCE=securevault-api
